# Copy to .env in backend/ and run Maven from that directory.
# Plain KEY=value entries; no shell export prefix or surrounding quotes.
OPENAI_API_KEY=
COURSE_GENERATION_MODEL=gpt-4.1-mini
GEOCODER_URL=https://geocode.maps.co
GEOCODER_API_KEY=
GEOCODER_AUTH_MODE=query
GEOCODER_MIN_INTERVAL_MS=1000
COVER_IMAGE_MODEL=gpt-4.1-mini
COVER_IMAGE_WORKER_ENABLED=true
